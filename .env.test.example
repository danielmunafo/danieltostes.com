# Copy to `.env.test` at the repo root for local recruiter assistant manual testing.
# Applied by `npm run dev:e2e` in services/recruiter-assistant-api when RECRUITER_E2E=1.

# Recruiter assistant API dev server (`services/recruiter-assistant-api` PORT)
RECRUITER_API_PORT=3001

# CORS: must match the browser origin of the site (scheme + host + port)
ALLOWED_ORIGIN=http://localhost:3000

# Inlined into the static export at build time
NEXT_PUBLIC_RECRUITER_API_URL=http://127.0.0.1:3001

# Leave reCAPTCHA keys empty so chat POSTs skip verification and the UI omits the widget.
RECAPTCHA_SECRET_KEY=
RECRUITER_E2E=1
