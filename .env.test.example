# Copy to `.env.test` at the repo root for recruiter Playwright E2E.
# Loaded by `playwright.config.ts`, `scripts/e2e-recruiter-stack.mjs`, and e2e helpers.

# Static site (Playwright baseURL + `serve out`)
PLAYWRIGHT_SITE_PORT=3000

# Recruiter assistant API dev server (`services/recruiter-assistant-api` PORT)
RECRUITER_API_PORT=3001

# Start API + site when running `npm run test:e2e:recruiter`
PLAYWRIGHT_RECRUITER_STACK=1

# CORS: must match the browser origin of the site (scheme + host + port)
ALLOWED_ORIGIN=http://localhost:3000

# Inlined into the static export at build time (`npm run test:e2e:recruiter:stack`)
NEXT_PUBLIC_RECRUITER_API_URL=http://127.0.0.1:3001

# Do not set NEXT_PUBLIC_RECAPTCHA_SITE_KEY here. E2E clears reCAPTCHA so Send does not
# open the Security check dialog (see scripts/e2e-recruiter-stack.mjs).

# Optional overrides (defaults are derived from the ports above)
# PLAYWRIGHT_BASE_URL=http://localhost:3000
# RECRUITER_API_HEALTH_URL=http://127.0.0.1:3001/health
