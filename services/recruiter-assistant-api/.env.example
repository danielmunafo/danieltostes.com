# Copy to `.env` and/or `.env.local` in this directory. Do not commit those files.
# `npm run dev` and `npm run build:embeddings` load `.env` then `.env.local` automatically (Next-style: `.env.local` overrides).
# Optional: still use `set -a && source .env && set +a` if you prefer the shell to set variables.

# Required for local dev and for `npm run build:embeddings` (use one of the key sources below).
OPENAI_API_KEY=

# Optional — OpenAI chat model for all recruiter LLM stages (intent gate, RAG, pitch, references). Default: gpt-4.1-nano (see CHAT_MODEL in src/constants.ts).
# RECRUITER_CHAT_MODEL=gpt-4.1-nano

# Production / Lambda only — leave unset locally if you use OPENAI_API_KEY above.
# OPENAI_SECRET_ARN=arn:aws:secretsmanager:REGION:ACCOUNT:secret:name

# Local RAG corpus — run `npm run build:embeddings` in this directory first; it prints `Wrote .../embeddings/embeddings.v<sha>.json`.
# Point here relative to this directory (or use an absolute path). Filename changes when corpus text changes.
# EMBEDDINGS_JSON_PATH=embeddings/embeddings.vxxxxxxxxxxxxxxxx.json

# Optional private preference rubric — for a quick try, point at the committed shape sample (replace with `npm run build:interests-pack` output for real rules, gitignored under `private/`).
# INTERESTS_PACK_JSON_PATH=private.example/interests-pack.example.json
# Or: copy `private.example/interests.source.example.md` → `private/interests.source.md`, run `npm run build:interests-pack`, then set path to the printed `private/interests-pack.<hash>.json`.

# First `npm run dev` runs predev: builds embeddings + LlamaIndex index if missing (needs OPENAI_API_KEY).
# Force rebuild: FORCE_RAG_REBUILD=1 npm run dev
# One-shot both artifacts: npm run build:rag

# Retrieval provider: custom (default) | llamaindex-hydrated | llamaindex-native | compare
# RECRUITER_RETRIEVER_PROVIDER=custom
# When compare fails on LlamaIndex load, fall back to custom only if explicitly set:
# RECRUITER_RETRIEVER_FALLBACK=custom
# Compare mode uses hydrated native index unless set:
# RECRUITER_COMPARE_LLAMAINDEX_MODE=hydrated

# Lambda (set once; CI overwrites this object when corpus changes):
# EMBEDDINGS_S3_URI=s3://your-bucket/embeddings.json
# EMBEDDINGS_S3_BUCKET=
# EMBEDDINGS_S3_KEY=embeddings.json

# LlamaIndex native index (run `npm run build:llamaindex-index` locally first):
# LLAMAINDEX_INDEX_JSON_PATH=embeddings/llamaindex.vxxxxxxxxxxxxxxxx.json
# LLAMAINDEX_INDEX_S3_URI=s3://your-bucket/llamaindex-index.json
# LLAMAINDEX_INDEX_S3_BUCKET=
# LLAMAINDEX_INDEX_S3_KEY=llamaindex-index.json

# Optional interests pack in S3 (same pattern as embeddings; never commit the object):
# INTERESTS_PACK_S3_URI=s3://your-bucket/interests-pack.json
# INTERESTS_PACK_S3_BUCKET=
# INTERESTS_PACK_S3_KEY=interests-pack.json
# When configured, interests alignment runs server-side only; non-empty output is stdout-logged as [recruiter-interests-not-in-response] and is not sent to browsers or merged into the pitch brief.

# Comma-separated browser `Origin` header values allowed to call the API (CORS). Matching is exact:
# `http://localhost:3000` and `http://127.0.0.1:3000` are different — list both if you use either to open Next.
# In production, include every real site origin (e.g. https://example.com,https://www.example.com).
ALLOWED_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# reCAPTCHA v2 — server-side verification on chat POST. Leave unset locally to skip verify.
# RECAPTCHA_SECRET_KEY=

# Dev HTTP server port (default 3001)
# PORT=3001
