{
  "name": "recruiter-assistant-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/handler.ts --bundle --platform=node --target=node20 --outfile=dist/index.cjs --format=cjs --sourcemap --loader:.md=text",
    "build:watch": "esbuild src/handler.ts --bundle --platform=node --target=node20 --outfile=dist/index.cjs --format=cjs --sourcemap --loader:.md=text --watch",
    "build:embeddings": "node scripts/build-embeddings.mjs",
    "build:interests-pack": "node scripts/build-interests-pack.mjs",
    "dev": "node scripts/dev-with-watch.mjs",
    "dev:server": "node --enable-source-maps scripts/dev-server.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.3.24",
    "@aws-sdk/client-s3": "^3.787.0",
    "@aws-sdk/client-secrets-manager": "^3.787.0",
    "ai": "^4.3.19",
    "openai": "^4.104.0",
    "pino": "^9.14.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.149",
    "@types/node": "^20.17.50",
    "esbuild": "^0.25.5",
    "typescript": "^5.8.3",
    "vitest": "^4.0.18"
  }
}
