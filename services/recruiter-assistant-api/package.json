{
  "name": "recruiter-assistant-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/esbuild-build.mjs",
    "build:watch": "node scripts/esbuild-build.mjs --watch",
    "build:rag": "npm run build:llamaindex-index",
    "build:llamaindex-index": "node scripts/build-llamaindex-index.mjs",
    "build:interests-pack": "node scripts/build-interests-pack.mjs",
    "build:prompt-manifest": "node scripts/build-prompt-manifest.mjs",
    "check:prompt-version-bump": "node scripts/check-prompt-version-bump.mjs",
    "predev": "node scripts/ensure-rag-artifacts.mjs",
    "dev": "node scripts/dev-with-watch.mjs",
    "dev:e2e": "RECRUITER_E2E=1 npm run dev",
    "dev:server": "node --enable-source-maps scripts/dev-server.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:snapshot": "node scripts/eval-snapshot-corpus.mjs",
    "eval:retrieval": "node scripts/eval-retrieval.mjs",
    "eval:e2e": "node scripts/eval-e2e.mjs",
    "feedback:review": "node scripts/feedback-review-queue.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.3.24",
    "@aws-sdk/client-s3": "^3.787.0",
    "@aws-sdk/client-secrets-manager": "^3.787.0",
    "@llamaindex/openai": "^0.4.22",
    "ai": "^4.3.19",
    "llamaindex": "^0.12.1",
    "openai": "^4.104.0",
    "pino": "^9.14.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.149",
    "@types/node": "^20.17.50",
    "esbuild": "^0.28.0",
    "typescript": "^5.8.3",
    "vitest": "^4.0.18"
  }
}
