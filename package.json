{
  "name": "danieltostes-com",
  "version": "0.4.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:with-diagrams": "npm run render-mermaid && npm run dev",
    "build": "npm run build-search-index && npm run render-mermaid && next build && node scripts/inject-location-hash-preserver.mjs; ec=$?; git checkout -- public/content/ 2>/dev/null; exit $ec",
    "build-search-index": "node scripts/build-search-index.mjs",
    "render-mermaid": "node scripts/render-mermaid.mjs",
    "start": "serve out -p 3000",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && start-server-and-test 'npx serve out -p 3000' http://localhost:3000 'playwright test --project=smoke'",
    "test:e2e:ci": "start-server-and-test 'npx serve out -p 3000' http://localhost:3000 'playwright test --project=smoke'",
    "prepare": "husky"
  },
  "dependencies": {
    "@ai-sdk/react": "^1.2.12",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.8",
    "@mui/material": "^7.3.8",
    "@mui/material-nextjs": "^7.3.8",
    "ai": "^4.3.19",
    "fuse.js": "^7.0.0",
    "next": "16.1.6",
    "next-intl": "^4.8.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-google-recaptcha": "^3.1.0",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.4",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^11.12.0",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-google-recaptcha": "^2.1.9",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "serve": "^14.2.5",
    "start-server-and-test": "^2.1.3",
    "typescript": "^5",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx,json,css,md}": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
