# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing (Vitest + Playwright)
/coverage
/test-results
/playwright-report
/blob-report
/playwright/.cache

# Next.js
/.next/
/out/

# production / build
/build

# build-time generated Mermaid diagram SVGs
public/content/diagrams/

# build-time generated search index
public/search-index.json

# recruiter assistant API (generated)
services/recruiter-assistant-api/dist/
services/recruiter-assistant-api/embeddings/*.json

# env files (opt-in to commit if needed)
.env*
!.env.example
!**/.env.example

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# TypeScript
*.tsbuildinfo
next-env.d.ts

# misc
.DS_Store
*.pem

# deploy (project uses GitHub → AWS; optional local Vercel CLI)
.vercel
